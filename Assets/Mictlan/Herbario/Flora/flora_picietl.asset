  id: picietl
  nombreNahuatl: Picietl
  glosa: tabaco silvestre
  nombreEspanol: "tabaco cimarr\xF3n"
  nombreCientifico: Nicotiana rustica
  descripcion: "Tabaco fuerte de hoja ancha. Molido con cal se vuelve tenexyetl,
    que protege contra lo que da\xF1a sin dejarse ver."
  notaTicitl: "Golp\xE9alo nueve veces, como se hac\xEDa. Ni una m\xE1s, ni una menos."
  fuente: "Sahag\xFAn; Ruiz de Alarc\xF3n (1629)"
  ilustracion: {fileID: 0}
  muestrasParaEstudiar: 3
  nivelPrincipal: -1
  roles: 6
  notaDiseno: "Cosecha con 9 golpes (golpesParaCosechar = 9). Verificar en Ruiz de
    Alarc\xF3n el ep\xEDteto ritual de 'nueve veces golpeado'."
