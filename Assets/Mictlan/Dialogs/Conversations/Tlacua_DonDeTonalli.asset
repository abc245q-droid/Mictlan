%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5cc74ef59e49a8940b2c14507691cd06, type: 3}
  m_Name: Tlacua_DonDeTonalli
  m_EditorClassIdentifier: Assembly-CSharp::Conversation
  descripcion: "Tlacua otorga el don del Tonalli \u2014 Chicunamictlan, Sala Tlacua"
  nodes:
  - nodeName: Don de Tlacua
    lines:
    - speaker: Tlacua
      text: "\xA1Vaya! Esa Tlahuelpuchtli s\xED que da miedo, \xBFverdad?"
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      esAcotacion: 0
      personaje: {fileID: 11400000, guid: fb732a6c0cbc188498d6397c3c3d04e0, type: 2}
      expresion: 
      limpiarRetratos: 0
    - speaker: Tlacua
      text: Yo soy Tlacua, emisario de Huehueteotl, nuestro padre.
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      esAcotacion: 0
      personaje: {fileID: 11400000, guid: fb732a6c0cbc188498d6397c3c3d04e0, type: 2}
      expresion: 
      limpiarRetratos: 0
    - speaker: Tlacua
      text: "Me ha otorgado la misi\xF3n de encender los braseros de Chicunamictl\xE1n,
        \xA1pero esas brujas no dejan de molestarme!"
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      esAcotacion: 0
      personaje: {fileID: 11400000, guid: fb732a6c0cbc188498d6397c3c3d04e0, type: 2}
      expresion: 
      limpiarRetratos: 0
    - speaker: Tlacua
      text: "\xA1Oye! T\xFA pareces ser fuerte, \xBFme ayudas? A cambio te puedo
        entregar un contenedor de Tonalli."
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      esAcotacion: 0
      personaje: {fileID: 11400000, guid: fb732a6c0cbc188498d6397c3c3d04e0, type: 2}
      expresion: 
      limpiarRetratos: 0
    - speaker: Tlacua
      text: "En total son 9 braseros, hay que encenderlos por el ritual del fuego
        neuvo, t\xFA sabes..."
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      esAcotacion: 0
      personaje: {fileID: 11400000, guid: fb732a6c0cbc188498d6397c3c3d04e0, type: 2}
      expresion: 
      limpiarRetratos: 0
    - speaker: Tlacua
      text: "T\xFA despejas la zona de Mictecahs y yo los enciendo, \xBFtrato?"
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      esAcotacion: 0
      personaje: {fileID: 11400000, guid: fb732a6c0cbc188498d6397c3c3d04e0, type: 2}
      expresion: 
      limpiarRetratos: 0
    - speaker: 
      text: "Romerito asiente. Tlacua extiende una mano peque\xF1a y sucia. Un calor
        dorado recorre el pecho del ajolote."
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      esAcotacion: 1
      personaje: {fileID: 0}
      expresion: 
      limpiarRetratos: 0
    - speaker: Tlacua
      text: Listo, ahora puedes usar el Tonalli disperso para curarte.
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      esAcotacion: 0
      personaje: {fileID: 11400000, guid: fb732a6c0cbc188498d6397c3c3d04e0, type: 2}
      expresion: 
      limpiarRetratos: 0
    - speaker: Tlacua
      text: "M\xE1s adelante hay uno de los braseros..."
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      esAcotacion: 0
      personaje: {fileID: 11400000, guid: fb732a6c0cbc188498d6397c3c3d04e0, type: 2}
      expresion: 
      limpiarRetratos: 0
    - speaker: Tlacua
      text: "\xA1Vamos!"
      speakerColor: {r: 0, g: 0, b: 0, a: 0}
      esAcotacion: 0
      personaje: {fileID: 11400000, guid: fb732a6c0cbc188498d6397c3c3d04e0, type: 2}
      expresion: 
      limpiarRetratos: 0
    choices: []
    nextNode: -1
